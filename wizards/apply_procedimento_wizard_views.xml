<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_afr_qualificacao_os_apply_procedimento_wizard_form" model="ir.ui.view">
        <field name="name">afr.qualificacao.os.apply.procedimento.wizard.form</field>
        <field name="model">afr.qualificacao.os.apply.procedimento.wizard</field>
        <field name="arch" type="xml">
            <form string="Aplicar Procedimento">
                <sheet>
                    <group>
                        <field name="os_id" readonly="1"/>
                        <field name="overwrite_existing"/>
                    </group>
                    <separator string="Qualificações alvo"/>
                    <field name="line_ids" nolabel="1">
                        <tree editable="bottom" create="0" delete="0"
                              decoration-warning="not procedimento_id">
                            <field name="selected" widget="boolean_toggle" string="Aplicar"/>
                            <field name="qualificacao_id" readonly="1" force_save="1" string="Qualificação" options="{'no_open': True}"/>
                            <field name="equipment_id" readonly="1" options="{'no_open': True}"/>
                            <field name="equipment_category_id" string="Categoria" options="{'no_open': True}"/>
                            <field name="qualification_type" readonly="1"/>
                            <field name="state" readonly="1"/>
                            <field name="procedimento_id"/>
                            <field name="company_id" invisible="1"/>
                        </tree>
                    </field>
                </sheet>
                <footer>
                    <button name="action_apply" type="object"
                            string="Aplicar" class="btn-primary"/>
                    <button special="cancel" string="Cancelar" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
