<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_afr_qualificacao_relatorio_template_wizard_form" model="ir.ui.view">
        <field name="name">afr.qualificacao.relatorio.template.wizard.form</field>
        <field name="model">afr.qualificacao.relatorio.template.wizard</field>
        <field name="arch" type="xml">
            <form string="Template dos Relatórios Finais">
                <sheet>
                    <group>
                        <field name="os_id" readonly="1"/>
                        <field name="company_id" invisible="1"/>
                    </group>
                    <p class="text-muted">
                        Nenhuma regra (OS, cliente ou categoria) definiu o
                        template do relatório de alguns equipamentos. Escolha
                        o template nas linhas destacadas; as demais já estão
                        resolvidas e aparecem só para conferência.
                    </p>
                    <field name="line_ids" nolabel="1">
                        <tree editable="bottom" create="0" delete="0"
                              decoration-warning="pending and not relatorio_template_id"
                              decoration-muted="not pending">
                            <field name="pending" invisible="1" force_save="1"/>
                            <field name="equipment_id" readonly="1" force_save="1" options="{'no_open': True}"/>
                            <field name="category_id" readonly="1" options="{'no_open': True}"/>
                            <field name="company_id" invisible="1"/>
                            <field name="relatorio_template_id"
                                   domain="[('company_id', 'in', [company_id, False])]"
                                   attrs="{'readonly': [('pending', '=', False)], 'required': [('pending', '=', True)]}"
                                   force_save="1"
                                   options="{'no_create': True}"/>
                            <field name="origem" invisible="1" force_save="1"/>
                            <field name="origem_label" widget="badge" string="Origem"/>
                        </tree>
                    </field>
                    <group>
                        <field name="save_as_default"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Gerar relatórios" class="btn-primary"/>
                    <button special="cancel" string="Cancelar"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
