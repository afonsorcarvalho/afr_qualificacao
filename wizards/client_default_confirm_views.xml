<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_client_default_confirm_form" model="ir.ui.view">
        <field name="name">afr.qualificacao.client.default.confirm.form</field>
        <field name="model">afr.qualificacao.client.default.confirm</field>
        <field name="arch" type="xml">
            <form string="Substituir o padrão deste cliente?">
                <h3><field name="message" nolabel="1"/></h3>
                <field name="partner_id" invisible="1"/>
                <field name="category_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <group>
                    <group string="Padrão atual">
                        <field name="old_price"/>
                        <field name="old_days"/>
                    </group>
                    <group string="Novo padrão">
                        <field name="new_price"/>
                        <field name="new_days"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Substituir" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
