<?xml version="1.0" encoding="utf-8"?>
<!--
    Grupos de segurança conforme práticas recomendadas na documentação do Odoo:
    https://www.odoo.com/documentation/16.0/pt_BR/developer/reference/backend/security.html

    Hierarquia (implies):
      group_afr_qualificacao_technician  ← técnico de campo (vê OS atribuída, preenche relatório+coleta)
      group_afr_qualificacao_user        ← implies technician + gestor operacional (cria OS, edita config)
      group_afr_qualificacao_manager     ← implies user + aprova OS/qualifs, edita procedimentos
-->
<odoo>

    <!-- Categoria do módulo (form do user agrupa nossos grupos juntos) -->
    <record id="module_category_afr_qualificacao" model="ir.module.category">
        <field name="name">Qualificações</field>
        <field name="description">Gestão de Qualificações (QI/QO/QD/QS/Calibração)</field>
        <field name="sequence">40</field>
    </record>

    <record id="group_afr_qualificacao_technician" model="res.groups">
        <field name="name">Técnico</field>
        <field name="category_id" ref="module_category_afr_qualificacao"/>
        <field name="comment">Acesso restrito: vê OS atribuídas, preenche relatórios e coletas. Não edita procedimentos nem aprova OS.</field>
    </record>

    <record id="group_afr_qualificacao_user" model="res.groups">
        <field name="name">Usuário</field>
        <field name="category_id" ref="module_category_afr_qualificacao"/>
        <field name="implied_ids" eval="[(4, ref('group_afr_qualificacao_technician'))]"/>
    </record>

    <record id="group_afr_qualificacao_manager" model="res.groups">
        <field name="name">Gestor</field>
        <field name="category_id" ref="module_category_afr_qualificacao"/>
        <field name="implied_ids" eval="[(4, ref('group_afr_qualificacao_user'))]"/>
    </record>

    <!--
        Task 9 — o grupo Técnico ganhou perm_write em afr.qualificacao.os
        (ir.model.access.csv) só pra permitir a transição scheduled → in_progress
        feita pelo próprio PWA de campo. Sem uma ir.rule, isso deixaria o
        técnico escrever (e, via write direto, até "aprovar") QUALQUER OS, não
        só a sua.

        Restringe o write do grupo Técnico a `tecnico_default_user_id == uid`.

        Pegadinha: group_afr_qualificacao_user IMPLIES group_afr_qualificacao_technician
        (e manager implies user), então todo Usuário/Gestor também está no
        grupo Técnico e cairia nesta regra restritiva. Regras de registro são
        ORed entre os grupos do usuário — por isso a segunda regra abaixo,
        permissiva, anexada a group_afr_qualificacao_user (que Usuário e
        Gestor herdam), garante que eles continuam com write global.
    -->
    <record id="rule_qualificacao_os_technician_write_own" model="ir.rule">
        <field name="name">Técnico só escreve a própria OS</field>
        <field name="model_id" ref="model_afr_qualificacao_os"/>
        <field name="groups" eval="[(4, ref('group_afr_qualificacao_technician'))]"/>
        <field name="domain_force">[('tecnico_default_user_id', '=', user.id)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="active" eval="True"/>
    </record>

    <record id="rule_qualificacao_os_user_write_all" model="ir.rule">
        <field name="name">Usuário/Gestor escreve qualquer OS</field>
        <field name="model_id" ref="model_afr_qualificacao_os"/>
        <field name="groups" eval="[(4, ref('group_afr_qualificacao_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="active" eval="True"/>
    </record>

</odoo>
