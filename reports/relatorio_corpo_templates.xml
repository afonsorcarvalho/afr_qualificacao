<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Corpo do Relatório Final. Variáveis opcionais (chaves de `data` do report):
          page_map     {"bloco:<id>" | "anexo:<code>": nº página} — impresso no índice como veio
          with_markers bool — emite <span class="rq-mark">@@RQ:...@@</span> (branco, 1pt)
        Marcador SEMPRE como 1º filho do container que quebra página (P4 localiza
        a página pelo texto extraído).
    -->
    <template id="rq_styles">
        <style>
            .rq-page { color: #212529; font-size: 13px; line-height: 1.45; font-family: Arial, Helvetica, sans-serif; }
            .rq-mark { color: #ffffff; font-size: 1pt; line-height: 1pt; position: absolute; }
            .rq-page-break { page-break-before: always; }
            .rq-title { margin: 18px 0 8px 0; color: #0A3D62; page-break-after: avoid; }
            .rq-title-l1 { font-size: 19px; font-weight: bold; text-transform: uppercase; padding-bottom: 5px; border-bottom: 1px solid #C9D3DC; }
            .rq-title-l1 .rq-title-num { color: #F86A30; font-size: 27px; margin-right: 12px; }
            .rq-title-child { font-size: 14.5px; font-weight: bold; margin: 12px 0 5px 0; }
            .rq-title-child .rq-title-num { margin-right: 8px; }
            .rq-body { text-align: justify; }
            .rq-body blockquote, .rq-box-info { margin: 8px 0; padding: 6px 10px; border-left: 3px solid #F86A30; background: #EEF2F5; }
            .rq-box-info { border-left-color: #0A3D62; }
            .rq-box-warn { margin: 8px 0; padding: 6px 10px; border-left: 3px solid #C0392B; background: #FBECEC; font-weight: bold; }
            .rq-box-label { display: block; color: #C0392B; font-size: 9.5px; font-weight: bold; text-transform: uppercase; }
            .rq-subtitle { color: #0A3D62; font-weight: bold; font-size: 14px; margin: 14px 0 5px 0; page-break-after: avoid; }
            .rq-table { width: 100%; border-collapse: collapse; margin: 4px 0 12px 0; font-size: 11px; }
            .rq-table th, .rq-table td { border: none; border-bottom: 1px solid #DCE3E9; padding: 3px 6px; vertical-align: top; text-align: left; }
            .rq-table thead th { color: #0A3D62; font-weight: bold; border-bottom: 1px solid #0A3D62; }
            .rq-table tbody tr th, .rq-table > tr > th { color: #5A7184; font-size: 9px; font-weight: normal; text-transform: uppercase; }
            .rq-table tr { page-break-inside: avoid; }
            .rq-keep { page-break-inside: avoid; }
            .rq-cover { padding-top: 40px; }
            .rq-cover-logo img { max-width: 60mm; max-height: 30mm; }
            .rq-cover-title { font-size: 28px; font-weight: bold; color: #0A3D62; margin: 110px 0 0 0; padding-bottom: 8px; border-bottom: 2px solid #F86A30; text-transform: uppercase; }
            .rq-cover-subtitle { font-size: 13px; color: #5A7184; margin: 10px 0 70px 0; }
            .rq-cover-meta { width: 75%; border-top: 1px solid #0A3D62; }
            .rq-cover-meta td { font-weight: bold; color: #212529; }
            /* separate: com collapse, o WebKit do wkhtmltopdf desenha o
               "border-style: solid" do reboot do Bootstrap no tbody. */
            .rq-toc { width: 100%; border-collapse: separate; border-spacing: 0; font-size: 12px; margin-top: 4px; }
            .rq-toc, .rq-toc thead, .rq-toc tbody, .rq-toc tr, .rq-toc td { border: 0 none !important; background: transparent !important; }
            .rq-toc td { padding: 2px 4px; vertical-align: baseline; }
            .rq-toc a { display: block; color: inherit !important; text-decoration: none !important; }
            .rq-toc-l1 td { font-weight: bold; color: #0A3D62; padding-top: 8px; }
            .rq-toc-num { width: 46px; color: #F86A30; }
            .rq-toc-child td { color: #3D4D5C; font-size: 11.5px; }
            .rq-toc-child .rq-toc-title { padding-left: 16px; }
            .rq-toc-child .rq-toc-num { color: #8A9AA8; }
            .rq-toc-page-cell { width: 40px; text-align: right; color: #5A7184; }
            .rq-anexo-sep { page-break-before: always; page-break-after: always; padding-top: 230px; }
            .rq-anexo-eyebrow { color: #5A7184; font-size: 11px; letter-spacing: 3px; text-transform: uppercase; }
            .rq-anexo-num { color: #F86A30; font-size: 64px; font-weight: bold; line-height: 1; }
            .rq-anexo-title { color: #0A3D62; font-size: 20px; font-weight: bold; text-transform: uppercase; margin-top: 8px; }
            .rq-anexo-rule { width: 60px; border-top: 3px solid #F86A30; margin: 12px 0; }
            .rq-doc-header { margin-bottom: 12px; padding-bottom: 6px; border-bottom: 2px solid #F86A30; }
            .rq-doc-title { font-size: 19px; font-weight: bold; color: #0A3D62; text-transform: uppercase; }
            .rq-doc-number { font-size: 12px; color: #5A7184; }
        </style>
    </template>

    <template id="rq_block_capa">
        <div class="rq-cover">
            <div class="rq-cover-logo" t-if="doc.company_id.logo">
                <img t-att-src="image_data_uri(doc.company_id.logo)" alt="logo"/>
            </div>
            <div class="rq-cover-title">Relatório de Qualificação Térmica</div>
            <div class="rq-cover-subtitle">
                <t t-esc="doc.equipment_id.name or ''"/><t t-if="doc.partner_id"> — <t t-esc="doc.partner_id.name"/></t>
            </div>
            <table class="rq-table rq-cover-meta">
                <tr><th style="width:38%;">Código</th><td t-esc="doc.name"/></tr>
                <tr><th>Revisão</th><td t-esc="doc.revision_label"/></tr>
                <tr><th>Data de emissão</th><td t-esc="cover_date or ''"/></tr>
                <tr><th>Equipamento</th><td t-esc="doc.equipment_id.name or ''"/></tr>
                <tr><th>Nº de série / TAG</th><td><t t-esc="doc.equipment_id.serial_number or '—'"/> / <t t-esc="doc.equipment_id.tag or '—'"/></td></tr>
                <tr><th>Cliente</th><td t-esc="doc.partner_id.name or ''"/></tr>
                <tr><th>Emitente</th><td t-esc="doc.company_id.name or ''"/></tr>
                <tr><th>Período dos ensaios</th>
                    <td><t t-esc="doc._fmt_date(doc.data_inicio_ensaios)"/> a <t t-esc="doc._fmt_date(doc.data_fim_ensaios)"/></td></tr>
            </table>
        </div>
    </template>

    <!-- Link com a chave do page_map: relatorio_pdf.link_toc troca por salto
         interno para a página final (TOC_LINK_PREFIX). -->
    <template id="rq_block_indice">
        <table class="rq-toc">
            <t t-foreach="doc._report_index_entries()" t-as="entry">
                <t t-set="toc_href" t-value="'http://rq-toc.invalid/%s' % entry['key']"/>
                <tr t-attf-class="rq-toc-row #{'rq-toc-child' if entry['child'] else 'rq-toc-l1'}">
                    <td class="rq-toc-num"><a t-att-href="toc_href" t-esc="doc._rq_fmt_number(entry['number'])"/></td>
                    <td class="rq-toc-title"><a t-att-href="toc_href" t-esc="entry['title']"/></td>
                    <td class="rq-toc-page-cell"><a t-att-href="toc_href"><span class="rq-toc-page" t-esc="pmap.get(entry['key'], '')"/></a></td>
                </tr>
            </t>
        </table>
    </template>

    <template id="rq_block_protocolo">
        <div class="rq-doc-header">
            <div class="rq-doc-title">PROTOCOLO DE QUALIFICAÇÃO TÉRMICA</div>
            <div class="rq-doc-number" t-esc="doc._doc_number('PrQT')"/>
        </div>

        <div class="rq-subtitle">1. Identificação do Cliente</div>
        <table class="rq-table">
            <tr><th style="width:30%;">Cliente</th><td t-esc="doc.partner_id.name or ''"/></tr>
            <tr><th>CNPJ/CPF</th><td t-esc="doc.partner_id.vat or ''"/></tr>
            <tr><th>Endereço</th><td t-esc="doc.partner_id.contact_address or ''"/></tr>
        </table>

        <div class="rq-subtitle">2. Identificação do Equipamento</div>
        <table class="rq-table">
            <tr><th style="width:30%;">Equipamento</th><td t-esc="doc.equipment_id.name or ''"/></tr>
            <tr><th>Categoria</th><td t-esc="doc.equipment_id.category_id.name or ''"/></tr>
            <tr><th>Marca</th><td t-esc="doc.equipment_id.marca_id.name or ''"/></tr>
            <tr><th>Modelo</th><td t-esc="doc.equipment_id.model or ''"/></tr>
            <tr><th>Número de série</th><td t-esc="doc.equipment_id.serial_number or ''"/></tr>
            <tr><th>TAG</th><td t-esc="doc.equipment_id.tag or ''"/></tr>
            <tr><th>Patrimônio</th><td t-esc="doc.equipment_id.patrimony or ''"/></tr>
        </table>

        <div class="rq-subtitle">3. Condições Ambientais e Período</div>
        <table class="rq-table">
            <tr><th style="width:30%;">Temperatura ambiente</th><td t-esc="doc.amb_temperatura or ''"/></tr>
            <tr><th>Umidade relativa</th><td t-esc="doc.amb_umidade or ''"/></tr>
            <tr><th>Início dos ensaios</th><td t-esc="doc._fmt_date(doc.data_inicio_ensaios)"/></tr>
            <tr><th>Fim dos ensaios</th><td t-esc="doc._fmt_date(doc.data_fim_ensaios)"/></tr>
        </table>

        <div class="rq-subtitle">4. Ciclos</div>
        <table class="rq-table">
            <thead><tr><th>Etapa</th><th>Ciclo</th><th>Qtd</th><th>Temperatura</th><th>Tempo</th></tr></thead>
            <tbody>
                <t t-foreach="doc._report_cycle_rows()" t-as="row">
                    <tr>
                        <td t-esc="row['etapa']"/>
                        <td t-esc="row['name']"/>
                        <td t-esc="row['qty']"/>
                        <td t-esc="row['temperature']"/>
                        <td t-esc="row['duration']"/>
                    </tr>
                </t>
            </tbody>
        </table>

        <div class="rq-subtitle">5. Lista de Verificação (QI)</div>
        <table class="rq-table">
            <thead><tr><th>Grupo</th><th>Item</th><th>Resultado</th><th>Comentário</th></tr></thead>
            <tbody>
                <t t-foreach="doc.checklist_ids.sorted(lambda c: (c.sequence, c.id))" t-as="item">
                    <tr>
                        <td t-esc="item.grupo or ''"/>
                        <td t-esc="item.descricao or ''"/>
                        <td t-esc="doc._sel_label(item, 'status')"/>
                        <td t-esc="item.comentario or ''"/>
                    </tr>
                </t>
            </tbody>
        </table>

        <div class="rq-subtitle">6. Disposição dos Sensores</div>
        <t t-foreach="doc._report_sensor_tables()" t-as="st">
            <div t-esc="st['cycle']" style="font-weight:bold;"/>
            <table class="rq-table">
                <thead><tr><th>Canal</th><th>Posição</th><th>Indicador</th></tr></thead>
                <tbody>
                    <t t-foreach="st['rows']" t-as="pos">
                        <tr>
                            <td t-esc="pos.canal or ''"/>
                            <td t-esc="pos.posicao or ''"/>
                            <td t-esc="pos.ib_label or ''"/>
                        </tr>
                    </t>
                </tbody>
            </table>
        </t>

        <div class="rq-keep">
        <div class="rq-subtitle">7. Instrumentos e Padrões</div>
        <table class="rq-table">
            <thead><tr><th>Instrumento</th><th>Identificação</th><th>Função</th><th>Papel do certificado</th><th>Nº</th><th>Calibração</th><th>Validade</th></tr></thead>
            <tbody>
                <t t-foreach="doc._report_instrument_rows()" t-as="row">
                    <tr>
                        <td t-esc="row['instrument']"/>
                        <td t-esc="row['identification']"/>
                        <td t-esc="row['resource_role']"/>
                        <td t-esc="row['role']"/>
                        <td t-esc="row['certificate']"/>
                        <td t-esc="row['date']"/>
                        <td t-esc="row['validade']"/>
                    </tr>
                </t>
            </tbody>
        </table>
        </div>
    </template>

    <template id="rq_block_laudo_micro">
        <div class="rq-doc-header">
            <div class="rq-doc-title">LAUDO MICROBIOLÓGICO</div>
            <div class="rq-doc-number" t-esc="doc._doc_number('ReQM')"/>
        </div>
        <div class="rq-keep">
        <div class="rq-subtitle">Indicadores utilizados</div>
        <table class="rq-table">
            <thead><tr><th>Tipo</th><th>Marca</th><th>Modelo / Tipo</th><th>Lote</th><th>Validade</th><th>Valor D (min)</th><th>População</th></tr></thead>
            <tbody>
                <t t-foreach="doc.indicador_ids" t-as="ind">
                    <tr>
                        <td t-esc="doc._sel_label(ind, 'tipo')"/>
                        <td t-esc="ind.marca or ''"/>
                        <td t-esc="ind.modelo_tipo or ''"/>
                        <td t-esc="ind.lote or ''"/>
                        <td t-esc="doc._fmt_date(ind.validade)"/>
                        <td t-esc="doc._fmt_num(ind.valor_d) if ind.valor_d else ''"/>
                        <td t-esc="ind.populacao or ''"/>
                    </tr>
                </t>
            </tbody>
        </table>
        </div>
        <div class="rq-subtitle">Leituras dos indicadores biológicos</div>
        <table class="rq-table">
            <thead><tr><th>Ciclo</th><th>Lote</th><th>Qtd. IB</th><th>Incubação</th><th>Leitura</th><th>Leitor</th><th>Resultado</th><th>Controle positivo</th></tr></thead>
            <tbody>
                <t t-foreach="doc.leitura_ib_ids" t-as="lt">
                    <tr>
                        <td t-esc="lt.cycle_id.display_name or ''"/>
                        <td t-esc="lt.indicador_id.lote or ''"/>
                        <td t-esc="lt.quantidade"/>
                        <td t-esc="doc._fmt_date(lt.data_incubacao)"/>
                        <td t-esc="doc._fmt_date(lt.data_leitura)"/>
                        <td t-esc="lt.leitor or ''"/>
                        <td t-esc="doc._sel_label(lt, 'resultado')"/>
                        <td t-esc="'Crescimento (OK)' if lt.controle_positivo_ok else 'Não conforme'"/>
                    </tr>
                </t>
            </tbody>
        </table>
    </template>

    <template id="rq_block_assinaturas">
        <table class="rq-table">
            <thead><tr><th>Papel</th><th>Nome</th><th>Registro</th><th>Aprovação</th></tr></thead>
            <tbody>
                <t t-foreach="doc._report_signature_rows()" t-as="row">
                    <tr>
                        <td t-esc="row['papel']"/>
                        <td t-esc="row['nome']"/>
                        <td t-esc="row['registro']"/>
                        <td t-esc="row['approved_at'] or '______________________'"/>
                    </tr>
                </t>
            </tbody>
        </table>
    </template>

    <!-- Um bloco. Espera: doc, block, block_numbers, markers, pmap -->
    <template id="rq_block">
        <t t-set="blk_num" t-value="block_numbers.get(block.id, '')"/>
        <div t-att-class="'rq-block rq-page-break' if block.page_break else 'rq-block'"
             t-att-data-rq-block="block.id"><span t-if="markers" class="rq-mark" t-esc="'@@RQ:bloco:%s@@' % block.id"/>
            <div t-if="block.show_title and block.block_kind != 'capa' and (block.title or blk_num)"
                 t-attf-class="rq-title #{'rq-title-child' if block.parent_id else 'rq-title-l1'}">
                <t t-if="blk_num"><span class="rq-title-num" t-esc="doc._rq_fmt_number(blk_num)"/></t><span t-esc="block.title or ''"/>
            </div>
            <t t-if="block.block_kind == 'capa'"><t t-call="afr_qualificacao.rq_block_capa"/></t>
            <t t-if="block.block_kind == 'indice'"><t t-call="afr_qualificacao.rq_block_indice"/></t>
            <t t-if="block.block_kind == 'protocolo'"><t t-call="afr_qualificacao.rq_block_protocolo"/></t>
            <t t-if="block.block_kind == 'laudo_micro'"><t t-call="afr_qualificacao.rq_block_laudo_micro"/></t>
            <t t-if="block.block_kind == 'assinaturas'"><t t-call="afr_qualificacao.rq_block_assinaturas"/></t>
            <div t-if="block.block_kind not in ('capa', 'indice') and block.body"
                 class="rq-body" t-out="doc._render_block_body(block)"/>
        </div>
    </template>

    <!-- Uma posição de anexo incluída: página separadora (+ conteúdo se slot 'bloco'). Espera: doc, anexo, markers -->
    <template id="rq_anexo">
        <div class="rq-anexo-sep" t-att-data-rq-anexo="anexo.code"><span t-if="markers" class="rq-mark" t-esc="'@@RQ:anexo:%s@@' % anexo.code"/>
            <div class="rq-anexo-eyebrow">Anexo</div>
            <div class="rq-anexo-num" t-esc="anexo.numero"/>
            <div class="rq-anexo-title" t-esc="anexo.title or ''"/>
            <div class="rq-anexo-rule"/>
        </div>
        <t t-if="anexo.slot_kind == 'bloco' and anexo.block_id and anexo.block_id.included">
            <t t-set="block" t-value="anexo.block_id"/>
            <t t-call="afr_qualificacao.rq_block"/>
        </t>
    </template>

    <template id="report_relatorio_corpo">
        <t t-foreach="docs" t-as="doc">
            <t t-call="web.basic_layout">
                <t t-set="markers" t-value="bool(with_markers)"/>
                <t t-set="pmap" t-value="page_map or {}"/>
                <t t-set="block_numbers" t-value="doc._block_numbering()"/>
                <t t-call="afr_qualificacao.rq_styles"/>
                <div class="page rq-page">
                    <t t-foreach="doc._body_blocks()" t-as="block">
                        <t t-call="afr_qualificacao.rq_block"/>
                    </t>
                    <t t-foreach="doc._anexos_included()" t-as="anexo">
                        <t t-call="afr_qualificacao.rq_anexo"/>
                    </t>
                </div>
            </t>
        </t>
    </template>
</odoo>
