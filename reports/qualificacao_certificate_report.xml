<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_qualificacao_certificate" model="ir.actions.report">
        <field name="name">Certificado de Qualificação</field>
        <field name="model">afr.qualificacao</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">afr_qualificacao.qualificacao_certificate_template</field>
        <field name="report_file">afr_qualificacao.qualificacao_certificate_template</field>
        <field name="print_report_name">'Certificado - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_afr_qualificacao"/>
        <field name="binding_type">report</field>
        <!--
            Sem `groups_id`, o gate de `state == 'approved'` que existe em
            `action_print_certificate` não cobria `/report/pdf/...` nem o menu
            Imprimir da UI — os dois contornam o método, e o único controle
            que sobrava era a marca d'água "SEM VALIDADE" do template.
            Emitir certificado é ato de escritório: Usuário (e Gestor, que o
            herda) imprimem; o Técnico de campo, não.
        -->
        <field name="groups_id" eval="[(4, ref('afr_qualificacao.group_afr_qualificacao_user'))]"/>
    </record>
</odoo>
