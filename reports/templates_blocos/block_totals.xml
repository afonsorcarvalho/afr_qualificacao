<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tabela de totais compartilhada. Quem a chama é o EMISSOR de totais
         (`doc._proposal_totals_emitter()`: bloco `financial` ou, na falta
         dele, o fim do `equipment_scope`) ou, sem emissor, o fim da lista de
         blocos em quotation_template.xml. As linhas vêm de
         `doc._qualif_total_rows()` — mesma fonte do portal e do banner do
         form, para os três não divergirem. -->
    <template id="qq_totals_table">
        <table class="qq-total-table">
            <t t-foreach="doc._qualif_total_rows()" t-as="trow">
                <tr>
                    <td class="qq-tot-label" t-esc="trow[0]"/>
                    <td class="qq-tot-value">
                        <span t-esc="trow[1]"
                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                    </td>
                </tr>
            </t>
            <tr class="qq-total-grand">
                <td class="qq-tot-label">Valor Geral da Proposta</td>
                <td class="qq-tot-value">
                    <span t-esc="doc.amount_untaxed"
                          t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                </td>
            </tr>
        </table>
    </template>
</odoo>
