<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Capítulo de uma família de serviço: tabela dos serviços cotados com
         subtotal e relação das unidades identificadas. Dados de
         `sale.order._service_group_table` (mesma fonte do portal e do
         snapshot HTML). Sem linhas do grupo, não imprime nada. -->
    <template id="qq_block_service_group">
                            <t t-set="sg_table" t-value="doc._service_group_table(block.service_group_id) if block.service_group_id else {'rows': []}"/>
                            <div t-att-class="sec_class" t-if="block._prints_chapter()">
                                <t t-set="sg_title" t-value="block.service_group_id._chapter_title()"/>
                                <div t-attf-class="qq-section-title{{ ' qq-section-title-child' if is_child else '' }}"
                                     t-if="block.show_title">
                                    <t t-if="blk_num"><span t-esc="blk_num"/> — </t>
                                    <span t-esc="block.title or sg_title"/>
                                </div>
                                <table class="qq-table">
                                    <tr>
                                        <th style="width: 7%;">Item</th>
                                        <th>Serviço</th>
                                        <th style="width: 8%;">Qtd</th>
                                        <th style="width: 18%; text-align: right;">Valor Unitário</th>
                                        <th style="width: 18%; text-align: right;">Valor Total</th>
                                    </tr>
                                    <t t-foreach="sg_table['rows']" t-as="sg_row">
                                        <tr>
                                            <td><span t-esc="sg_row['item']"/></td>
                                            <td>
                                                <strong t-esc="sg_row['name']"/>
                                                <div t-if="sg_row['description']" style="font-size: 9px;">
                                                    <span t-esc="sg_row['description']"/>
                                                </div>
                                                <div t-if="sg_row['procedure']" style="font-size: 9px;">
                                                    Procedimento: <span t-esc="sg_row['procedure']"/>
                                                </div>
                                            </td>
                                            <td>
                                                <span t-esc="int(sg_row['qty']) if sg_row['qty'] == int(sg_row['qty']) else sg_row['qty']"/>
                                            </td>
                                            <td style="text-align: right;">
                                                <span t-esc="sg_row['price_unit']"
                                                      t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                            </td>
                                            <td style="text-align: right;">
                                                <span t-esc="sg_row['subtotal']"
                                                      t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                            </td>
                                        </tr>
                                    </t>
                                </table>
                                <table class="qq-total-table">
                                    <tr>
                                        <td class="qq-tot-label"><span t-esc="'Subtotal %s:' % sg_title"/></td>
                                        <td class="qq-tot-value">
                                            <span t-esc="sg_table['subtotal']"
                                                  t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                        </td>
                                    </tr>
                                    <tr t-if="sg_table['days_label']">
                                        <td class="qq-tot-label" colspan="2"><span t-esc="sg_table['days_label']"/></td>
                                    </tr>
                                </table>
                                <t t-if="sg_table['units']">
                                    <div class="qq-scope-subtitle">
                                        <strong t-esc="'Relação de %ss' % (block.service_group_id.unit_label or 'unidade')"/>
                                    </div>
                                    <table class="qq-table">
                                        <tr>
                                            <th style="width: 7%;">Item</th>
                                            <th>Identificação</th>
                                            <th>Descrição</th>
                                            <th>Marca / Modelo</th>
                                            <th>Série</th>
                                            <th>Local</th>
                                        </tr>
                                        <t t-foreach="sg_table['units']" t-as="sg_unit">
                                            <tr>
                                                <td><span t-esc="sg_unit.item_number or '—'"/></td>
                                                <td><span t-esc="sg_unit.tag or ''"/></td>
                                                <td><span t-esc="sg_unit.description or ''"/></td>
                                                <td><span t-esc="' / '.join(v for v in (sg_unit.marca, sg_unit.model) if v)"/></td>
                                                <td><span t-esc="sg_unit.serial_number or ''"/></td>
                                                <td><span t-esc="sg_unit.location or ''"/></td>
                                            </tr>
                                        </t>
                                    </table>
                                </t>
                            </div>
    </template>
</odoo>
