<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Montagem do PDF do Relatório Final em etapas. Acordado por _trigger()
             a cada enfileiramento/unidade; o intervalo é só rede de segurança. -->
        <record id="ir_cron_relatorio_build_job" model="ir.cron">
            <field name="name">Relatório Final: montagem de PDF em etapas</field>
            <field name="model_id" ref="afr_qualificacao.model_afr_relatorio_build_job"/>
            <field name="state">code</field>
            <field name="code">model._cron_process()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
