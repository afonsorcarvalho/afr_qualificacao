<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Barra do editor de bloco. mousedown.prevent: o clique não tira o
         foco do editável (senão blur → commit e a seleção se perde). -->
    <t t-name="afr_qualificacao.RqBlockHtmlField" t-inherit="web_editor.HtmlField" t-inherit-mode="primary" owl="1">
        <xpath expr="//HtmlFieldWysiwygAdapterComponent" position="before">
            <div class="rq-toolbar">
                <button type="button" class="btn btn-sm btn-light" title="Inserir variável do relatório"
                        t-on-mousedown.prevent="" t-on-click="() => this.openVariables()">
                    <i class="fa fa-tag me-1"/>Variável
                </button>
            </div>
        </xpath>
    </t>

    <t t-name="afr_qualificacao.RqVariableDialog" owl="1">
        <Dialog title="'Inserir variável'" size="'md'">
            <input type="search" class="form-control mb-3" placeholder="Buscar por nome ou expressão…"
                   t-model="state.search" autofocus="autofocus"/>
            <div class="rq-var-list">
                <t t-foreach="groups" t-as="group" t-key="group.name">
                    <h6 class="text-muted text-uppercase small mt-3 mb-1" t-esc="group.name"/>
                    <div class="list-group list-group-flush">
                        <t t-foreach="group.items" t-as="item" t-key="item.expr">
                            <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center gap-2"
                                    t-att-title="'{{ ' + item.expr + ' }}'" t-on-click="() => this.pick(item)">
                                <span t-esc="item.label"/>
                                <t t-if="props.showValues">
                                    <small t-if="hasValue(item)" class="text-muted text-truncate" style="max-width: 50%">→ <t t-esc="item.value"/></small>
                                    <small t-else="" class="text-warning">sem valor</small>
                                </t>
                            </button>
                        </t>
                    </div>
                </t>
                <p t-if="!groups.length" class="text-muted mb-0">Nenhuma variável encontrada.</p>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-secondary" t-on-click="props.close">Cancelar</button>
            </t>
        </Dialog>
    </t>

</templates>
