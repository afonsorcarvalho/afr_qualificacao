# URL é definida pelo usuário no login (salva em cookie + localStorage).
# Variáveis abaixo são opcionais — só usadas como fallback se quiser
# fixar um Odoo padrão (single-tenant).
# ODOO_URL=http://seu-odoo.com

# Groq API key — assistente IA (auto-resumo turno + ditado voz).
# Obtenha em https://console.groq.com/keys
GROQ_API_KEY=
