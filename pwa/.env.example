# Origens Odoo que o proxy `/api/odoo` pode alcançar — allowlist separada por
# vírgula, no formato `esquema://host[:porta]`. OBRIGATÓRIA em produção: sem
# ela o proxy recusa tudo (403), porque encaminhar para endereço arbitrário
# transforma o servidor Next em open proxy/SSRF (ele enxerga hosts internos
# que o navegador do atacante não enxerga).
# Em NODE_ENV=development, loopback e rede privada são liberados sem config.
# ODOO_ALLOWED_ORIGINS=https://labquali.afrsistemas.com.br,http://localhost:8069

# Odoo padrão quando o usuário não escolhe servidor no login (instância única).
# Se definido e ODOO_ALLOWED_ORIGINS estiver vazio, vale como allowlist de um
# item só.
# ODOO_URL=http://seu-odoo.com

# Groq API key — assistente IA (auto-resumo turno + ditado voz).
# Obtenha em https://console.groq.com/keys
GROQ_API_KEY=
