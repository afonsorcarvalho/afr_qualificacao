# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# `.env` é o arquivo de SEGREDOS do deploy (chaves de API, allowlist). O
# default do Next ignora só `.env*.local`, o que deixa `.env` aparecendo como
# untracked no `git status` do servidor — a um `git add -A` de ser commitado.
# Verificado em 2026-09-22 no labquali, com OPENROUTER_API_KEY real dentro.
# Os `*.example` continuam versionados pela negação abaixo.
.env
.env.*
!.env.example
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code local settings
.claude/settings.local.json

# next-pwa generated
public/sw.js
public/sw.js.map
public/workbox-*.js
public/workbox-*.js.map

# scratch de processo (relatórios/notas de subagente) — não confundir com
# docs/superpowers/ (planos/specs), que continua tracked de propósito.
/.superpowers/
