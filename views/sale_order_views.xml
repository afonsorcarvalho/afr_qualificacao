<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit form sale.order: botão configurador + stat buttons + colunas linhas -->
    <record id="view_sale_order_form_inherit_qualificacao" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.qualificacao</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header/button[@name='action_quotation_send']" position="before">
                <button name="action_open_configurator"
                        string="Configurar Serviços"
                        type="object"
                        class="oe_highlight"
                        attrs="{'invisible': ['|', ('state','not in',['draft','sent']), ('partner_id','=',False)]}"/>
                <button name="action_open_generate_os_wizard"
                        string="Gerar OS de Qualificação"
                        type="object"
                        class="oe_highlight"
                        groups="afr_qualificacao.group_afr_qualificacao_user"
                        attrs="{'invisible': [('pode_gerar_os','=',False)]}"/>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_qualificacoes"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-tasks"
                        attrs="{'invisible': [('qualificacao_count','=',0)]}">
                    <field name="qualificacao_count" widget="statinfo" string="Qualificações"/>
                </button>
                <button name="action_view_qualificacao_os"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-clipboard"
                        attrs="{'invisible': [('qualificacao_os_count','=',0)]}">
                    <field name="qualificacao_os_count" widget="statinfo" string="OS Qualif"/>
                </button>
                <button name="action_view_engc_os"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-wrench"
                        attrs="{'invisible': [('engc_os_count','=',0)]}">
                    <field name="engc_os_count" widget="statinfo" string="OSs (legacy)"/>
                </button>
            </xpath>

            <!-- Aviso (não bloqueia): grupo de serviço cotado sem capítulo
                 "Serviços do Grupo" visível na proposta. Topo da folha,
                 para aparecer em qualquer aba (Linhas, Unidades, Proposta). -->
            <xpath expr="//sheet/div[@name='button_box']" position="after">
                <div class="alert alert-warning" role="alert"
                     attrs="{'invisible': [('service_chapter_warning', '=', False)]}">
                    <field name="service_chapter_warning" nolabel="1" readonly="1"/>
                </div>
            </xpath>

            <!-- Esconde page "Order Lines" padrão — substituída pelas 3 abas custom abaixo -->
            <xpath expr="//page[@name='order_lines']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- has_qualif_lines / is_managed_quote: campos invisíveis dos attrs.
                 is_managed_quote (qualificação OU serviço) governa os totais;
                 has_qualif_lines só o que é por equipamento. -->
            <xpath expr="//field[@name='order_line']" position="after">
                <field name="has_qualif_lines" invisible="1"/>
                <field name="has_service_lines" invisible="1"/>
                <field name="is_managed_quote" invisible="1"/>
                <field name="pode_gerar_os" invisible="1"/>
            </xpath>

            <!-- Subtotais por equipamento: lado direito (sale_total group), acima do tax_totals -->
            <xpath expr="//group[@name='sale_total']/field[@name='tax_totals']" position="before">
                <field name="qualif_subtotals_html"
                       nolabel="1"
                       readonly="1"
                       colspan="2"
                       attrs="{'invisible': [('is_managed_quote','=',False)]}"/>
            </xpath>

            <!-- 3 abas custom inseridas ANTES da page order_lines padrão -->
            <xpath expr="//page[@name='order_lines']" position="before">
                <page string="Linhas (Comercial)" name="qualif_comercial">
                    <field name="regular_line_ids" widget="section_and_note_one2many">
                        <tree editable="bottom">
                            <control>
                                <create name="add_product" string="Adicionar produto"/>
                                <create name="add_section" string="Adicionar seção"
                                        context="{'default_display_type': 'line_section'}"/>
                                <create name="add_note" string="Adicionar nota"
                                        context="{'default_display_type': 'line_note'}"/>
                            </control>
                            <field name="sequence" widget="handle"/>
                            <field name="display_type" invisible="1"/>
                            <field name="is_qualif_discount_line" invisible="1"/>
                            <field name="is_service_managed" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                            <field name="product_uom_category_id" invisible="1"/>
                            <field name="product_id"
                                   attrs="{'required': [('display_type','=',False)], 'readonly': ['|', ('is_qualif_discount_line','=',True), ('is_service_managed','=',True)]}"/>
                            <field name="service_id" string="Serviço" readonly="1"
                                   optional="show"
                                   attrs="{'invisible': [('is_service_managed','=',False)],
                                           'column_invisible': [('parent.has_service_lines','=',False)]}"/>
                            <field name="name" widget="section_and_note_text"
                                   attrs="{'readonly': [('is_qualif_discount_line','=',True)]}"/>
                            <field name="product_uom_qty" optional="show"
                                   attrs="{'readonly': [('is_qualif_discount_line','=',True)]}"/>
                            <field name="service_unit_progress" optional="show"
                                   attrs="{'column_invisible': [('parent.has_service_lines','=',False)]}"/>
                            <field name="product_uom"
                                   groups="uom.group_uom" optional="hide"
                                   attrs="{'required': [('display_type','=',False)]}"/>
                            <field name="price_unit"
                                   attrs="{'readonly': [('is_qualif_discount_line','=',True)]}"/>
                            <field name="discount" string="Desc.%" optional="hide"/>
                            <field name="tax_id" widget="many2many_tags" optional="hide"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="price_subtotal" widget="monetary"/>
                        </tree>
                    </field>
                    <!-- Preço-alvo por equipamento: entre as linhas e os subtotais,
                         para o rateio ficar ao lado do que ele reprecifica. -->
                    <div attrs="{'invisible': [('has_qualif_lines','=',False)]}">
                        <separator string="Preço e tempo combinados por equipamento"/>
                        <field name="equipment_target_ids" nolabel="1">
                            <tree editable="bottom" create="false" delete="false"
                                  decoration-warning="equipment_target_state == 'drift'"
                                  decoration-success="equipment_target_state == 'ok'">
                                <field name="equipment_target_state" invisible="1"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="name" string="Equipamento" readonly="1"/>
                                <field name="equipment_subtotal" string="Preço atual"
                                       widget="monetary" readonly="1"/>
                                <field name="equipment_target_price" string="Preço combinado"
                                       widget="monetary"/>
                                <field name="equipment_target_delta" string="Diferença"
                                       widget="monetary" readonly="1" optional="hide"/>
                                <field name="equipment_current_hours" string="Horas atuais"
                                       widget="float_time" readonly="1" optional="hide"/>
                                <field name="equipment_target_days" string="Tempo combinado (dias)"/>
                                <field name="equipment_apply_state" string="Situação do combinado" readonly="1"
                                       widget="badge"
                                       decoration-success="equipment_apply_state == 'ok'"
                                       decoration-warning="equipment_apply_state == 'drift'"
                                       decoration-danger="equipment_apply_state == 'issue'"
                                       attrs="{'invisible': [('equipment_apply_state','=','none')]}"/>
                                <field name="equipment_target_issue" string="Motivo" readonly="1"
                                       optional="show"/>
                                <button name="action_reapply_equipment_targets"
                                        type="object" string="Reaplicar"
                                        icon="fa-refresh" class="btn-link"
                                        attrs="{'invisible': ['|', ('equipment_apply_state','not in',['drift','issue']), ('parent.state','not in',['draft','sent'])]}"/>
                                <button name="action_save_as_client_default"
                                        type="object" string="Tornar padrão cliente"
                                        icon="fa-bookmark"
                                        groups="afr_qualificacao.group_afr_qualificacao_manager"/>
                            </tree>
                        </field>
                    </div>
                    <group name="qualif_discount_group"
                           attrs="{'invisible': [('has_qualif_lines','=',False)]}">
                        <group string="Desconto geral (só sobre os Serviços de Qualificação)">
                            <label for="qualif_discount_value" string="Desconto geral"/>
                            <div class="o_row">
                                <field name="qualif_discount_type" class="oe_inline"
                                       attrs="{'readonly': [('state','not in',['draft','sent'])]}"/>
                                <field name="qualif_discount_value" class="oe_inline"
                                       attrs="{'readonly': [('state','not in',['draft','sent'])]}"/>
                            </div>
                        </group>
                    </group>
                    <field name="qualif_subtotals_html" nolabel="1" readonly="1"
                           attrs="{'invisible': [('is_managed_quote','=',False)]}"/>
                </page>

                <page string="Opcionais" name="qualif_opcionais">
                    <field name="optional_line_ids"
                           context="{'default_is_proposal_optional': 1}">
                        <tree editable="bottom">
                            <field name="is_proposal_optional" invisible="1"/>
                            <field name="sequence" widget="handle"/>
                            <field name="display_type" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                            <field name="product_uom_category_id" invisible="1"/>
                            <field name="product_id" attrs="{'required': [('display_type','=',False)]}"/>
                            <field name="name"/>
                            <field name="optional_qty" string="Qtd Opc."/>
                            <field name="price_unit"/>
                            <field name="optional_accepted" string="Aceito"
                                   widget="boolean_toggle"/>
                            <field name="product_uom_qty" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="price_subtotal" widget="monetary"/>
                        </tree>
                    </field>
                    <field name="qualif_subtotals_html" nolabel="1" readonly="1"
                           attrs="{'invisible': [('is_managed_quote','=',False)]}"/>
                </page>

                <page string="Detalhes Técnicos" name="qualif_tecnico"
                      attrs="{'invisible': [('has_qualif_lines','=',False)]}">
                    <field name="qualif_tecnico_html" nolabel="1" readonly="1"/>
                </page>

                <!-- Unidades de cada linha de serviço: numeradas na confirmação,
                     identificadas aqui (TAG/série ou pelo cadastro). -->
                <page string="Unidades" name="service_units"
                      attrs="{'invisible': [('has_service_lines','=',False)]}">
                    <field name="service_units_summary" readonly="1" nolabel="1"
                           class="fw-bold"/>
                    <field name="service_unit_ids" nolabel="1"
                           context="{'afr_service_line_short_name': True}">
                        <tree editable="bottom" decoration-success="is_identified">
                            <field name="is_identified" invisible="1"/>
                            <field name="item_number" invisible="1"/>
                            <field name="service_equipment_category_id" invisible="1"/>
                            <!-- Em branco (não "0") enquanto a unidade não tem número. -->
                            <field name="item_label" string="Item"/>
                            <field name="line_id" string="Serviço" required="1"
                                   context="{'afr_service_line_short_name': True}"
                                   domain="[('order_id', '=', parent.id), ('is_service_managed', '=', True)]"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="tag" string="Identificação"/>
                            <field name="description"/>
                            <field name="marca"/>
                            <field name="model"/>
                            <field name="serial_number"/>
                            <field name="location"/>
                            <field name="range_spec"/>
                            <field name="equipment_id"
                                   domain="[('client_id', '=', parent.partner_id), ('category_id', '=?', service_equipment_category_id)]"
                                   options="{'no_create': True}"/>
                        </tree>
                    </field>
                </page>
            </xpath>

            <!-- F8.2 — Proposta LEGO: aba de montagem de blocos da cotação (ao final) -->
            <xpath expr="//notebook" position="inside">
                <page string="Proposta (Blocos)" name="proposal_blocks">
                    <group>
                        <group>
                            <field name="proposal_template_id"
                                   options="{'no_create': True}"/>
                        </group>
                    </group>
                    <button name="action_reload_proposal_blocks"
                            type="object"
                            string="Carregar / Recarregar Blocos do Template"
                            class="btn-secondary"
                            confirm="Recarregar descarta as edições feitas nos blocos desta proposta. Continuar?"/>
                    <field name="proposal_block_ids">
                        <tree editable="bottom" decoration-muted="not is_applicable">
                            <field name="sale_order_id" invisible="1"/>
                            <field name="is_applicable" invisible="1"/>
                            <field name="sequence" widget="handle"/>
                            <field name="display_number" string="Nº" readonly="1"/>
                            <field name="included" widget="boolean_toggle"/>
                            <field name="show_number" widget="boolean_toggle"/>
                            <field name="show_title" widget="boolean_toggle"/>
                            <field name="title"/>
                            <field name="block_kind"/>
                            <field name="applies_when"/>
                            <field name="service_group_id"
                                   attrs="{'invisible': [('applies_when', '!=', 'service_group'), ('block_kind', '!=', 'service_group')],
                                           'required': ['|', ('applies_when', '=', 'service_group'), ('block_kind', '=', 'service_group')]}"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="hidden_reason" string="Oculto: motivo" readonly="1"/>
                            <field name="parent_id"
                                   domain="[('sale_order_id','=',parent.id),('id','!=',id)]"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="display_label" string="Conteúdo" readonly="1"/>
                            <field name="section_id" optional="hide"/>
                            <field name="page_break" widget="boolean_toggle"/>
                            <button name="action_edit_block" type="object"
                                    string="Editar" icon="fa-pencil"
                                    class="btn-link"/>
                        </tree>
                        <form>
                            <field name="sale_order_id" invisible="1"/>
                            <group>
                                <group>
                                    <field name="block_kind"/>
                                    <field name="title"/>
                                    <field name="applies_when"/>
                                    <field name="service_group_id"
                                           attrs="{'invisible': [('applies_when', '!=', 'service_group'), ('block_kind', '!=', 'service_group')],
                                                   'required': ['|', ('applies_when', '=', 'service_group'), ('block_kind', '=', 'service_group')]}"
                                           options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="parent_id"/>
                                    <field name="show_number"/>
                                    <field name="show_title"/>
                                </group>
                                <group>
                                    <field name="included"/>
                                    <field name="page_break"/>
                                    <field name="section_id" readonly="1"/>
                                </group>
                            </group>
                            <separator string="Conteúdo (aceita {{ expressões }})"/>
                            <field name="body" options="{'codeview': True}"/>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Esconde aba "Optional Products" do sale_management — não usada neste fluxo. -->
    <record id="view_sale_order_form_hide_optional_products" model="ir.ui.view">
        <field name="name">sale.order.form.hide.optional.products</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_management.sale_order_form_quote"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='optional_products']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
